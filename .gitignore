# Dependencies
node_modules/

# Build output and caches
dist/
dist-ssr/
.vite/
*.tsbuildinfo

# Test output
coverage/

# Environment files and credentials: never commit real values.
.env
.env.*
!.env.example
*.pem
*.key
google-credentials*.json
service-account*.json

# Supabase local state
.supabase/
supabase/.temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor: ignore local state, allow shared workspace defaults
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sw?
*.local
